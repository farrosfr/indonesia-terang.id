---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { formatDate, posts } from "../utils.js";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const related = posts.filter((item) => item.slug !== post.slug).slice(0, 3);
---

<BaseLayout title={`${post.title} | Indonesia Terang`} description={post.excerpt} image={post.image}>
  <article class="article-layout">
    <header class="article-hero">
      <p class="eyebrow">{post.categories.map((category) => category.name).join(" · ")} · {formatDate(post.date)}</p>
      <h1>{post.title}</h1>
      {post.image && <img src={post.image} alt="" loading="eager" />}
    </header>
    <div class="article-content" set:html={post.content} />
  </article>
  <section class="content-band content-band--soft">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Lanjut membaca</p>
        <h2>Artikel terkait</h2>
      </div>
    </div>
    <div class="post-grid">
      {related.map((item) => <PostCard post={item} compact />)}
    </div>
  </section>
</BaseLayout>
