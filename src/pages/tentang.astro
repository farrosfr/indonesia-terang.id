---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Pencerahan Energi untuk Nusantara";
---

<BaseLayout title={`${title} | Indonesia Terang`} description="Tentang Pintar dan gerakan Indonesia Terang untuk edukasi energi terbarukan.">
  <section class="page-hero page-hero--compact">
    <p class="eyebrow">Tentang Pintar</p>
    <h1>{title}</h1>
    <p>
      Pintar adalah ruang belajar dan bergerak bagi siapa pun yang ingin memahami energi bersih, membangun kapasitas, dan menghadirkan solusi yang relevan untuk Indonesia.
    </p>
  </section>
  <section class="content-band">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Arah kerja</p>
        <h2>Mempertemukan ilmu, praktik, dan dampak sosial.</h2>
      </div>
      <p>
        Indonesia Terang hadir untuk membantu komunitas, sekolah, perusahaan, dan pemangku kepentingan memahami potensi EBT melalui riset, studi kelayakan, pelatihan, dan program penerangan.
      </p>
    </div>
    <div class="impact-grid">
      <div class="impact-item"><h3>Riset</h3><p>Mengubah potensi energi menjadi rekomendasi yang bisa dijalankan.</p></div>
      <div class="impact-item"><h3>Belajar</h3><p>Menyediakan kelas Energy Hack yang dekat dengan kebutuhan lapangan.</p></div>
      <div class="impact-item"><h3>Komunitas</h3><p>Menjaga peserta tetap terhubung setelah pelatihan selesai.</p></div>
      <div class="impact-item"><h3>Dampak</h3><p>Mendorong program energi untuk desa dan wilayah yang membutuhkan.</p></div>
    </div>
  </section>
</BaseLayout>
