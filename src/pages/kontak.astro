---
import { Mail, MapPin, MessageCircle } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
---

<BaseLayout title="Kontak | Indonesia Terang" description="Hubungi Indonesia Terang untuk riset, pelatihan, komunitas, CSR, ESG, dan program donasi energi.">
  <section class="page-hero page-hero--compact">
    <p class="eyebrow">Kontak</p>
    <h1>Mulai diskusi energi bersih.</h1>
    <p>Ceritakan kebutuhan riset, pelatihan, studi kelayakan, komunitas, atau program penerangan yang ingin dijalankan.</p>
  </section>
  <section class="content-band">
    <div class="contact-grid">
      <div class="contact-panel flex flex-col gap-6">
        <div>
          <h2 class="text-2xl font-bold text-ink mb-1">Indonesia Terang</h2>
          <p class="text-muted-site m-0">Pusat Desain Industri Nasional (PDIN)</p>
        </div>
        
        <div class="flex flex-col gap-4">
          <a href="mailto:admin@solar-nusantara.id" class="flex items-center gap-3 text-ink hover:text-green transition-colors group">
            <div class="w-9 h-9 rounded-full bg-soft flex items-center justify-center text-green group-hover:bg-green group-hover:text-white transition-colors">
              <Mail size={18} />
            </div>
            <span class="font-medium">admin@solar-nusantara.id</span>
          </a>

          <a href="https://wa.me/6282180000575" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-ink hover:text-green transition-colors group">
            <div class="w-9 h-9 rounded-full bg-soft flex items-center justify-center text-green group-hover:bg-green group-hover:text-white transition-colors">
              <MessageCircle size={18} />
            </div>
            <span class="font-medium">+62 821-8000-0575</span>
          </a>

          <div class="flex items-start gap-3 text-ink">
            <div class="w-9 h-9 rounded-full bg-soft flex items-center justify-center text-green flex-shrink-0">
              <MapPin size={18} />
            </div>
            <p class="font-medium m-0 leading-relaxed pt-1">
              Jl. C. Simanjuntak No. 19, Terban, Kec. Gondokusuman, <br />
              Kota Yogyakarta, DIY 55223
            </p>
          </div>
        </div>
      </div>
      <div class="contact-panel flex flex-col gap-6">
        <div>
          <h2 class="text-2xl font-bold text-ink mb-1">Kirim Pesan</h2>
          <p class="text-muted-site m-0">Kami akan merespon pesan Anda secepatnya.</p>
        </div>
        <form name="contact" method="post" data-netlify="true" class="flex flex-col gap-4">
          <input type="hidden" name="form-name" value="contact" />
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input name="name" autocomplete="name" placeholder="Nama Lengkap" required class="bg-soft border-none focus:ring-2 focus:ring-green/20" />
            <input name="email" type="email" autocomplete="email" placeholder="Email Address" required class="bg-soft border-none focus:ring-2 focus:ring-green/20" />
          </div>
          <input name="topic" placeholder="Topik atau Subjek" class="bg-soft border-none focus:ring-2 focus:ring-green/20" />
          <textarea name="message" placeholder="Tulis pesan Anda di sini..." required rows="4" class="bg-soft border-none focus:ring-2 focus:ring-green/20 resize-none"></textarea>
          <Button type="submit" className="w-full bg-green hover:bg-green-dark text-white font-bold py-6 rounded-xl transition-all shadow-md hover:shadow-lg active:scale-[0.98]">
            Kirim Pesan Sekarang
          </Button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
